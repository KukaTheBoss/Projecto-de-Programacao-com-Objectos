@startuml erp-domain

hide circle
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor White
  ArrowColor Black
  BorderColor Black
}

' ===================== Núcleo =====================

class Erp {
  - proximoIdProduto: int
  - proximoIdEmpresa: int
  - proximoIdCompra: int
  - dataAtual: int
  - produtos: Map<Integer, Produto>
  - empresas: Map<Integer, Empresa>
  - clientes: Map<String, Cliente>
  - compras: Map<Integer, Compra>
  --
  + importarFicheiro(nomeFicheiro: String)
  + avancarData(dias: int)
}

class ErpManager {
  - erp: Erp
  --
  + guardar()
  + guardarComo(nomeFicheiro: String)
  + carregar(nomeFicheiro: String)
  + importarFicheiro(nomeFicheiro: String)
}

ErpManager "1" *-- "1" Erp

' ===================== Produto =====================

abstract class Produto {
  - id: int
  - nome: String
  - precoBase: int
  - categoria: String
  - prazoEntregaBase: int
  --
  + {abstract} getPrecoRecomendado(totalUnidades: int): double
}

class ProdutoNacional extends Produto {
  + getPrecoRecomendado(totalUnidades: int): double
}

class ProdutoImportado extends Produto {
  - paisOrigem: String
  - taxaAlfandegaria: double
  --
  + getPrecoRecomendado(totalUnidades: int): double
}

' ===================== Empresa / Disponibilização =====================

class Empresa {
  - id: int
  - nome: String
}

class Disponibilizacao {
  - unidades: int
  - factorMultiplicativo: double
  --
  + getPrecoVenda(): double
  + alterarInventario(deltaUnidades: int, novoFactor: double)
}

Empresa "1" *-- "0..*" Disponibilizacao
Disponibilizacao "0..*" --> "1" Produto

' ===================== Cliente / Notificações =====================

class Cliente {
  - email: String
  - nome: String
  - gastoTotal: double
}

interface MecanismoNotificacao {
  + notificar(assunto: String, descricao: String)
}

class MecanismoNotificacaoOmissao implements MecanismoNotificacao {
  - notificacoes: List<Notificacao>
  --
  + notificar(assunto: String, descricao: String)
  + consumirNotificacoes(): List<Notificacao>
}

class Notificacao {
  - assunto: String
  - descricao: String
}

Cliente "1" o-- "1" MecanismoNotificacao
MecanismoNotificacaoOmissao "1" *-- "0..*" Notificacao

' ===================== Cabaz =====================

class Cabaz {
  --
  + alterarProduto(produto: Produto, quantidade: int)
  + finalizar(): Compra
}

class LinhaCabaz {
  - quantidade: int
}

Cabaz "1" *-- "0..*" LinhaCabaz
LinhaCabaz "0..*" --> "1" Produto
Cabaz "0..*" --> "1" Cliente
Cabaz "0..*" --> "1" Empresa
Cabaz "1" --> "1" EstrategiaDivisao
Cabaz "1" --> "0..1" ModalidadeTransporte
Cabaz "1" o-- "0..*" ServicoAdicional

' ===================== Estratégia de divisão =====================

interface EstrategiaDivisao {
  + dividir(compra: Compra): List<Encomenda>
}

class EstrategiaUnica implements EstrategiaDivisao {
  + dividir(compra: Compra): List<Encomenda>
}

class EstrategiaPrazo implements EstrategiaDivisao {
  + dividir(compra: Compra): List<Encomenda>
}

' ===================== Modalidade de transporte =====================

abstract class ModalidadeTransporte {
  - id: String
  - tarifa: int
  - tempoEntrega: int
}

class ModalidadeNormal extends ModalidadeTransporte
class ModalidadeExpresso extends ModalidadeTransporte

' ===================== Serviço adicional =====================

abstract class ServicoAdicional {
  - id: String
  - custo: int
  - tempoAdicional: int
}

class Embrulho extends ServicoAdicional
class CartaoOferta extends ServicoAdicional

' ===================== Compra / Encomenda =====================

class Compra {
  - id: int
  - data: int
}

class LinhaCompra {
  - quantidade: int
  - precoUnitario: double
}

class Encomenda {
  - id: int
  - dataPrevistaEntrega: int
  - entregue: boolean
}

Compra "0..*" --> "1" Cliente
Compra "0..*" --> "1" Empresa
Compra "1" *-- "1..*" LinhaCompra
LinhaCompra "0..*" --> "1" Produto
Compra "1" *-- "1..*" Encomenda
Encomenda "1" --> "1" ModalidadeTransporte
Encomenda "1" o-- "0..*" ServicoAdicional
Encomenda "1" o-- "1..*" LinhaCompra

' ===================== Ligações ao núcleo =====================

Erp "1" *-- "0..*" Produto
Erp "1" *-- "0..*" Empresa
Erp "1" *-- "0..*" Cliente
Erp "1" *-- "0..*" Compra

@enduml
